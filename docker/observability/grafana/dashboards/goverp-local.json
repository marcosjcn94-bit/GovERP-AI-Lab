{
  "uid": "goverp-local",
  "title": "GovERP AI Lab · ambiente local",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requisicoes por minuto", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (http_route, http_status_code) (rate(goverp_http_requests_total[1m])) * 60", "legendFormat": "{{http_route}} · {{http_status_code}}", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "Latencia p50/p95", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "histogram_quantile(0.50, sum by (le) (rate(goverp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" }, { "expr": "histogram_quantile(0.95, sum by (le) (rate(goverp_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" }] },
    { "id": 3, "type": "timeseries", "title": "Fallback do modelo local", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "sum by (fallback) (rate(goverp_model_explanations_total[5m]))", "legendFormat": "fallback={{fallback}}", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "Achados demonstrativos", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "sum(rate(goverp_audit_findings_total[5m]))", "legendFormat": "achados/s", "refId": "A" }] }
  ]
}
