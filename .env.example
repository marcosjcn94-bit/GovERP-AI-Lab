GOVERP_PG_OWNER_PASSWORD=preencha-um-segredo-local-aleatorio
GOVERP_PG_APP_PASSWORD=preencha-outro-segredo-local-aleatorio
GOVERP_SESSION_SECRET=preencha-com-no-minimo-32-bytes-aleatorios
GOVERP_OWNER_DATABASE_URL=postgresql+psycopg://goverp_owner:SEGREDO@127.0.0.1:5440/goverp
GOVERP_APP_DATABASE_URL=postgresql+psycopg://goverp_app:SEGREDO@127.0.0.1:5440/goverp
GOVERP_MODEL_URL=http://127.0.0.1:11434
GOVERP_MODEL_NAME=qwen3:4b
GOVERP_MODEL_ENABLED=false
GOVERP_MODEL_TIMEOUT_SECONDS=20
GOVERP_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Tracing LangSmith opcional. Adicione a chave somente ao .env local ignorado pelo Git.
# LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=goverp-ai-lab-local
LANGSMITH_TRACING=true
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=true
# OpenTelemetry local e opcional; ativado pelo perfil observability do Compose.
GOVERP_OTEL_ENABLED=false
